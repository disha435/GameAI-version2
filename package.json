{
  "name": "gd-runtime",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.3",
    "express": "^4.22.2",
    "fast-json-patch": "^3.1.1",
    "openai": "^4.104.0",
    "pg": "^8.23.0",
    "phaser": "^3.80.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.13",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vitest": "^2.1.9"
  }
}
